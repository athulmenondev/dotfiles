{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "/home/athul/.config/fastfetch/img.png",
    //
    // --- THIS IS THE FIX ---
    //
    //"width": 40, // <-- ADD THIS LINE BACK (adjust 40 as you like)
    "height": 20,
    "padding": {
      "right":4,
      "left":4,
      "top": 5,
      "bottom":10,
    }
  },
  "display": {
    "separator": " ➜"
  },
  "modules": [
    {"type": "break"},
    {"type": "break"}, 
    "title",
    {"type": "custom", "format": "----------------"},
    {"type": "os", "key": "OS"},
    {"type": "kernel", "key": "  ├ Kernel"},
    {"type": "uptime", "key": "  ├ Uptime"},
    {"type": "packages", "key": "  └ Packages"},
    {"type": "break"}, 
    {"type": "break"}, 
    {"type": "host", "key": "PC"},
    {"type": "cpu", "key": "  ├ CPU", "format": "{} ({}) @ {}", "formatArgs": ["nameShort", "coresLogical", "speedMax"]},
    {"type": "memory", "key": "  ├ Memory"},
    {"type": "gpu", "key": "  ├ GPU"},
    {"type": "display", "key": "  └ Resolution"},
    {"type": "break"}, 
    {"type": "break"}, 
    {"type": "wm", "key": "WM"},
    {"type": "custom", "key": "  ├ Bar", "format": "Polybar"},
    {"type": "custom", "key": "  └ Compositor", "format": "Compton"},
    {"type": "break"}, 
    {"type": "break"}, 
    {"type": "terminal", "key": "TTY"},
    {"type": "shell", "key": "  ├ Shell"},
    {"type": "terminalfont", "key": "  └ Font"},
    {"type": "break"}, 
    {"type": "break"}, 
    "colors",
    {"type": "break"}
  ]
}
